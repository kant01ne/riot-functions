{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Receives Riot Sonar revocation webhooks and removes the Google Drive or Microsoft 365 permission with your own credentials."
  },
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "[concat('riot-revoker-', uniqueString(resourceGroup().id))]",
      "maxLength": 40,
      "metadata": { "description": "Function app name; also the first part of the webhook URL." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "releaseVersion": {
      "type": "string",
      "defaultValue": "1.0.0",
      "metadata": { "description": "Release of sonar-drive-items-revocation to run. Redeploy with a newer one to update." }
    },
    "riotWebhookSecret": {
      "type": "securestring",
      "metadata": { "description": "Riot endpoint secret (whsec_...). Comma-separate two during rotation." }
    },
    "msTenantId": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "Entra tenant ID. Leave empty for Google only." }
    },
    "msClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "Entra app (client) ID." }
    },
    "msClientSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": { "description": "Entra app client secret." }
    },
    "googleServiceAccountJson": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": { "description": "Google service account key with domain-wide delegation, raw JSON or base64. Leave empty for Microsoft only." }
    }
  },
  "variables": {
    "storageName": "[concat('rsr', uniqueString(resourceGroup().id, parameters('appName')))]",
    "packageUrl": "[concat('https://github.com/kant01ne/riot-functions/releases/download/sonar-drive-items-revocation-v', parameters('releaseVersion'), '/sonar-drive-items-revocation-azure.zip')]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard_LRS" },
      "kind": "StorageV2",
      "properties": { "minimumTlsVersion": "TLS1_2", "allowBlobPublicAccess": false, "supportsHttpsTrafficOnly": true }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[concat(parameters('appName'), '-logs')]",
      "location": "[parameters('location')]",
      "properties": { "sku": { "name": "PerGB2018" }, "retentionInDays": 30 }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "dependsOn": ["[resourceId('Microsoft.OperationalInsights/workspaces', concat(parameters('appName'), '-logs'))]"],
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', concat(parameters('appName'), '-logs'))]"
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Y1", "tier": "Dynamic" },
      "properties": {}
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('appName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]",
        "[resourceId('Microsoft.Insights/components', parameters('appName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('appName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "appSettings": [
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-05-01').keys[0].value)]"
            },
            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-05-01').keys[0].value)]"
            },
            { "name": "WEBSITE_CONTENTSHARE", "value": "[toLower(parameters('appName'))]" },
            { "name": "FUNCTIONS_EXTENSION_VERSION", "value": "~4" },
            { "name": "FUNCTIONS_WORKER_RUNTIME", "value": "node" },
            { "name": "WEBSITE_NODE_DEFAULT_VERSION", "value": "~22" },
            { "name": "WEBSITE_RUN_FROM_PACKAGE", "value": "[variables('packageUrl')]" },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', parameters('appName')), '2020-02-02').ConnectionString]"
            },
            { "name": "RIOT_WEBHOOK_SECRET", "value": "[parameters('riotWebhookSecret')]" },
            { "name": "GOOGLE_SERVICE_ACCOUNT_JSON", "value": "[parameters('googleServiceAccountJson')]" },
            { "name": "MS_TENANT_ID", "value": "[parameters('msTenantId')]" },
            { "name": "MS_CLIENT_ID", "value": "[parameters('msClientId')]" },
            { "name": "MS_CLIENT_SECRET", "value": "[parameters('msClientSecret')]" }
          ]
        }
      }
    }
  ],
  "outputs": {
    "webhookUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01').defaultHostName, '/api/webhook')]"
    },
    "statusUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01').defaultHostName, '/')]"
    }
  }
}
